# ── Nebius AI Studio ──────────────────────
NEBIUS_API_KEY=your_nebius_api_key_here
NEBIUS_MODEL=Qwen/Qwen3-14B
NEBIUS_CLOSING_MODEL=
NEBIUS_VISION_MODEL=Qwen/Qwen2.5-VL-72B-Instruct
NEBIUS_REQUEST_TIMEOUT_SECONDS=45
NEBIUS_CLOSING_TIMEOUT_SECONDS=12

# ── WAHA (WhatsApp HTTP API) ──────────────
WAHA_BASE_URL=http://localhost:3000
WAHA_SESSION=default
WAHA_API_KEY=your_waha_api_key_here

# ── Supabase ──────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key_here

# Web Push Notifications
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_CLAIMS_SUBJECT=mailto:admin@yourdomain.com
PUSH_NOTIFY_ALL_SUBSCRIBERS=true
CLOSING_DEAL_PUSH_SECRET=your_shared_closing_deal_secret_here

# Anti-spam defense
RATE_LIMIT_MESSAGES=5
RATE_LIMIT_WINDOW_SECONDS=60
STRANGER_RATE_LIMIT_MESSAGES=2
STRANGER_RATE_LIMIT_WINDOW_SECONDS=45
STRANGER_TRUST_MESSAGE_COUNT=2
ABUSE_BLOCK_THRESHOLD=3
AUTO_BLOCK_ABUSIVE_STRANGERS=true

# -- Logging --
LOG_LEVEL=INFO
LOG_FORMAT=text
